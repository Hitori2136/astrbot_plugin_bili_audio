{
  "enable_slicing": {
    "description": "语音切片",
    "type": "bool",
    "hint": "默认关闭，整段音频作为一条语音发送；开启后按切片长度拆成多条语音。",
    "default": false
  },
  "audio_chunk_seconds": {
    "description": "语音切片长度（秒）",
    "type": "int",
    "hint": "1-60。仅在开启语音切片时生效。",
    "default": 60
  },
  "max_audio_chunks": {
    "description": "最多发送多少段语音",
    "type": "int",
    "hint": "1-120。仅在开启语音切片时生效；超过后只发送前 N 段并提示。",
    "default": 30
  },
  "audio_send_interval": {
    "description": "语音段发送间隔（秒）",
    "type": "float",
    "hint": "0-5。仅在开启语音切片时生效。",
    "default": 0.6
  },
  "max_audio_mb": {
    "description": "源视频大小上限（MB）",
    "type": "int",
    "hint": "1-100。限制 B 站 360P 源文件体积，超过上限不下载。",
    "default": 100
  },
  "send_progress": {
    "description": "发送标题与进度提示",
    "type": "bool",
    "hint": "解析成功后先发送标题和“正在提取音频”的提示。",
    "default": true
  },
  "cooldown_seconds": {
    "description": "单用户冷却时间（秒）",
    "type": "int",
    "hint": "0-600。0 表示不限制；默认 20 秒，防止连续刷屏。",
    "default": 20
  },
  "max_concurrent": {
    "description": "最大同时处理任务数",
    "type": "int",
    "hint": "1-3。下载和转码比较吃资源，默认 1。",
    "default": 1
  },
  "timeout_seconds": {
    "description": "请求与转码超时（秒）",
    "type": "int",
    "hint": "10-600。接口请求按此值；下载另有至少 120 秒，转码最多 60 秒。",
    "default": 60
  },
  "cookie": {
    "description": "B 站 Cookie",
    "type": "string",
    "hint": "扫码登录时不用手动填。",
    "default": ""
  },
  "proxy": {
    "description": "下载代理",
    "type": "string",
    "hint": "例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891；留空直连。",
    "default": ""
  }
}
